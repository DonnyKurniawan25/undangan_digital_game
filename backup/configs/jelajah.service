[Unit]
Description=Jelajah Undangan Django application
After=network-online.target mysql.service
Wants=network-online.target
Requires=mysql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/jelajah
EnvironmentFile=/etc/jelajah/jelajah.env
ExecStart=/home/ubuntu/jelajah/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8090 --access-logfile - --error-logfile - --timeout 120 config.wsgi:application
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0022
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
