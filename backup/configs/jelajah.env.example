DJANGO_SETTINGS_MODULE=config.production
DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_ALLOWED_HOSTS=jelajah.biz.id,www.jelajah.biz.id,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://jelajah.biz.id,https://www.jelajah.biz.id
MYSQL_DATABASE=jelajah_db
MYSQL_USER=jelajah_app
MYSQL_PASSWORD=your-mysql-password-here
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
DJANGO_SECURE_SSL_REDIRECT=1
